# Firebase Web app config (safe to expose in a browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional when the API is deployed on a different origin
VITE_API_BASE_URL=

# Server-only settings
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Set this to the path of your Firebase Admin service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated Firebase Auth emails bootstrapped as administrators.
ADMIN_EMAILS=
